# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts friends' ESPN cookies (and later Yahoo tokens). Never change it once people have connected accounts.
ENCRYPTION_KEY=

# Comma-separated invite list. Leave empty to let anyone with the link sign up.
ALLOWED_EMAILS=you@example.com,friend@example.com

# Yahoo: from https://developer.yahoo.com/apps/ (see README)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must exactly match the Redirect URI registered with Yahoo.
# Leave empty in production to use https://<your-site>/auth/yahoo/callback automatically.
YAHOO_REDIRECT_URI=https://localhost:3000/auth/yahoo/callback
